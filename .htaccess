Options -Indexes
DirectoryIndex page.php index.html index.php

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Development and repository metadata must never be public on hosting.
    # These checks precede canonical redirects so a blocked implementation
    # file can never be exposed through a prettier URL.
    RewriteRule ^(?:\.git|\.github|inc|admin/inc|scripts|tools|release|dist|zálohy|Záloha)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:index(?:_v1_backup|%20chyba|\s+chyba)|sprava-balicku|kalkulacka)\.html$ - [F,L,NC]
    RewriteCond %{THE_REQUEST} \s/+page\.php(?:[?\s]|$) [NC,OR]
    RewriteCond %{THE_REQUEST} \s/+blog-(?:index|post)\.php(?:[?\s]|$) [NC,OR]
    RewriteCond %{THE_REQUEST} \s/+sitemap\.php(?:[?\s]|$) [NC]
    RewriteRule ^ - [F,L]

    # Direct requests for implementation files must land on the public URL in
    # one permanent hop.  THE_REQUEST prevents loops after internal rewrites.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
    RewriteRule ^index\.html$ https://www.ivproduction.cz/ [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+fotobudka\.html(?:[?\s]|$) [NC]
    RewriteRule ^fotobudka\.html$ https://www.ivproduction.cz/ivbudka/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+360budka\.html(?:[?\s]|$) [NC]
    RewriteRule ^360budka\.html$ https://www.ivproduction.cz/ivbudka360/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+promo\.html(?:[?\s]|$) [NC]
    RewriteRule ^promo\.html$ https://www.ivproduction.cz/aftermovie-promo-hudebniklipy/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+portfolio\.html(?:[?\s]|$) [NC]
    RewriteRule ^portfolio\.html$ https://www.ivproduction.cz/ukazky/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+blog\.html(?:[?\s]|$) [NC]
    RewriteRule ^blog\.html$ https://www.ivproduction.cz/svatebni-blog/ [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+l/[^?\s]+/index\.html(?:[?\s]|$) [NC]
    RewriteRule ^(l/[A-Za-z0-9-]+)/index\.html$ https://www.ivproduction.cz/$1/ [R=301,L,NE]

    # Never turn a missing .html file or the error document into a new URL.
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html(?:[?\s]|$) [NC]
    RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^([A-Za-z0-9-]+)\.html$ https://www.ivproduction.cz/$1/ [R=301,L,NE]

    # Alternative slugs from the development version have the same target.
    RewriteRule ^fotobudka/?$ https://www.ivproduction.cz/ivbudka/ [R=301,L,NE]
    RewriteRule ^360budka/?$ https://www.ivproduction.cz/ivbudka360/ [R=301,L,NE]
    RewriteRule ^promo/?$ https://www.ivproduction.cz/aftermovie-promo-hudebniklipy/ [R=301,L,NE]
    RewriteRule ^portfolio/?$ https://www.ivproduction.cz/ukazky/ [R=301,L,NE]
    RewriteRule ^blog/?$ https://www.ivproduction.cz/svatebni-blog/ [R=301,L,NE]

    # Indexed Webnode URLs whose content was consolidated in the new site.
    # Absolute targets keep these migrations to one hop regardless of the
    # incoming protocol, host or trailing slash.
    RewriteRule ^(?:predsvatebni-videa|svatebni-videa)/?$ https://www.ivproduction.cz/svatby/ [R=301,L,NE]
    RewriteRule ^video/?$ https://www.ivproduction.cz/ukazky/ [R=301,L,NE]
    RewriteRule ^(?:fotokoutky|pozadi)/?$ https://www.ivproduction.cz/ivbudka/ [R=301,L,NE]
    RewriteRule ^spoluprace/?$ https://www.ivproduction.cz/ukazky/ [R=301,L,NE]
    RewriteRule ^rezervacenasvatbu/?$ https://www.ivproduction.cz/kontakt/#poptavka [R=301,L,NE]
    RewriteRule ^evidenceplesu/?$ https://www.ivproduction.cz/plesy/ [R=301,L,NE]

    # Canonical public pages always use a trailing slash.  These rules run
    # before the generic host redirect to avoid redirect chains.
    RewriteRule ^(ivbudka|ivbudka360|aftermovie-promo-hudebniklipy|ukazky|svatebni-blog)$ https://www.ivproduction.cz/$1/ [R=301,L,NE]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([A-Za-z0-9-]+)$ https://www.ivproduction.cz/$1/ [R=301,L,NE]
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(l/[A-Za-z0-9-]+)$ https://www.ivproduction.cz/$1/ [R=301,L,NE]

    # One canonical HTTPS host for production, while preserving the path.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.ivproduction\.cz$ [NC]
    RewriteRule ^ https://www.ivproduction.cz%{REQUEST_URI} [R=301,L,NE]

    # Keep the historically indexed Webnode paths as the canonical public
    # routes and serve the new static implementation without another redirect.
    RewriteRule ^ivbudka/?$ page.php?file=fotobudka.html [L,QSA]
    RewriteRule ^ivbudka360/?$ page.php?file=360budka.html [L,QSA]
    RewriteRule ^aftermovie-promo-hudebniklipy/?$ page.php?file=promo.html [L,QSA]
    RewriteRule ^ukazky/?$ page.php?file=portfolio.html [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^svatebni-blog/?$ blog-index.php [L,QSA]
    RewriteRule ^(jak-vybrat-svatebniho-kameramana|trendy-svatebni-video-2026|proc-video-pomaha-prodat-nemovitost|jak-pripravit-firemni-video|video-pro-socialni-site|svatebni-lokace-kralovehradecky-kraj|hudba-ve-videu)/?$ blog-post.php?slug=$1 [L,QSA]
    RewriteRule ^l/([A-Za-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]
    RewriteRule ^clanky/([A-Za-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # All remaining one-segment clean routes map to their .html source file.
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([A-Za-z0-9-]+)/?$ page.php?file=$1.html [L,QSA]
</IfModule>

<FilesMatch "(?i)(?:^\.|\.(?:md|py|mjs|bak|tmp|admin-tmp|log|ini|example|lock|yml|yaml)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|webp|avif|png|jpg|jpeg|svg|ico|woff2?|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # These files are edited by the CMS and do not get a new filename.
    <FilesMatch "^(?:portfolio-data\.js|packages-data\.js|google-reviews\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
